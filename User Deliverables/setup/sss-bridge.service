[Unit]
Description=SSS Analysis-Deliverables Bridge
After=sss-flask.service
Requires=sss-flask.service

[Service]
Type=simple
User=sss
WorkingDirectory=/home/sss/user-deliverables
Environment=SSS_ANALYSIS_DIR=/home/sss/analysis_output
Environment=SSS_DATA_DIR=/home/sss/data
Environment=SSS_API_URL=http://127.0.0.1:5000
Environment=SSS_POLL_INTERVAL=5
ExecStart=/home/sss/user-deliverables/venv/bin/python integration/bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
