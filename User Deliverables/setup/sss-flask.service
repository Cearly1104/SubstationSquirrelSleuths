[Unit]
Description=SSS User Deliverables Flask App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sss
WorkingDirectory=/home/sss/SSS/User Deliverables
Environment="SSS_DATA_DIR=/home/sss/SSS/User Deliverables/data"
Environment="SSS_ACCOUNTS_FILE=/home/sss/SSS/User Deliverables/accounts.json"
Environment=SSS_SETTINGS_FILE=/home/sss/SSS/Codebase/settings.json
Environment=SSS_SETTINGS_DEFAULTS=/home/sss/SSS/Codebase/settings.default.json
Environment=SSS_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_VALUE
ExecStart=/home/sss/venvs/sss/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
